#ddev-generated
# Copy to `.ddev/.env.keycloak` to override anything the add-on sets on the
# `keycloak` service. DDEV applies that file after docker-compose.keycloak.yaml,
# so every value below wins over the add-on's default. Do not edit this example
# file - it is replaced when the add-on is updated, and DDEV ignores `.example`.
#
# Either write the file by hand or use:
#   ddev dotenv set .ddev/.env.keycloak --kc-hostname=https://example.com/keycloak
#
# Commit `.ddev/.env.keycloak` if the values are the same for the whole team.

# The public origin Keycloak writes into its metadata, redirects and SSO/SLO
# endpoints. Defaults to $DDEV_PRIMARY_URL/keycloak, which is the project's own
# <name>.<tld> - NOT an additional_fqdns entry. Set this whenever the project is
# reached under a different name, for example in a CI review app:
#   KC_HOSTNAME=https://mr-42.review.example.com/keycloak
# The path prefix has to be included: Keycloak does not append
# KC_HTTP_RELATIVE_PATH to a hostname given as a URL.
#KC_HOSTNAME=

# The path Keycloak is served under. Changing it also means changing
# .ddev/nginx/keycloak.conf and .ddev/apache/keycloak.conf, which proxy it.
#KC_HTTP_RELATIVE_PATH=/keycloak

# Admin credentials for the master realm.
#KC_BOOTSTRAP_ADMIN_USERNAME=admin
#KC_BOOTSTRAP_ADMIN_PASSWORD=password

# DEBUG is useful when a login fails for reasons Keycloak does not explain.
#KC_LOG_LEVEL=INFO

# Keycloak image tag, used for docker-compose interpolation.
#KEYCLOAK_TAG=26.0
